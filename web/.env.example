# ─────────────────────────────────────────────────────────────
# 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요.
#   cp .env.example .env.local
# .env.local 은 git 에 올라가지 않습니다. 키를 여기 직접 쓰지 마세요.
#
# Vercel 에 배포할 때는 이 값들을 Vercel 대시보드의
# Settings → Environment Variables 에 넣습니다. (DEPLOY.md 참고)
# ─────────────────────────────────────────────────────────────

# 세션 쿠키 서명에 쓰는 비밀키. 아무 긴 문자열이면 됩니다.
# 만드는 법:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ─── DB (Postgres + Prisma) ───
# Vercel 대시보드 → Storage 탭에서 Postgres를 만들면 접속 문자열이 나옵니다.
# 대부분 "풀링(pooled)" 문자열과 "직접(direct)" 문자열 두 개를 줍니다(제공사마다
# 변수 이름이 다름 — 예: POSTGRES_PRISMA_URL/POSTGRES_URL_NON_POOLING 등).
# 아래 두 이름으로 옮겨 적으세요. 풀링 문자열 하나만 준다면 둘 다 같은 값을 넣어도 됩니다.
#
#   DATABASE_URL — 앱이 실제 쿼리할 때 씀. 반드시 풀링(pgbouncer 등) 연결.
#   DIRECT_URL   — 마이그레이션(prisma migrate/db push)할 때만 씀. 직접 연결.
#
# 로컬에서 Postgres가 없다면 (Docker) `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres`
# 뒤 아래처럼 채우고 `npx prisma migrate deploy && npx prisma db seed` 를 실행하세요.
DATABASE_URL="postgresql://user:password@localhost:5432/db?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/db?schema=public"

# ─── 관리자 화면 접근 허용 목록 ───
# 이 이메일들(콤마 구분, 구글 계정 이메일)만 관리자 사이트(/admin 이하)에 들어올 수
# 있습니다. 비워두면 아무도 못 들어갑니다 — 본인 구글 계정을 꼭 넣으세요.
#   예: ADMIN_EMAILS=me@hamkke.org,manager@hamkke.org
ADMIN_EMAILS=

# ─── 참여자 사이트 / 관리자 사이트 가르기 ───
# 내 컴퓨터에서 개발할 때는 비워두세요.
# (비어 있으면 localhost / admin.localhost 로 알아서 갈립니다)
#
# Vercel 에 배포할 때만 넣습니다.
#   참여자 프로젝트  →  SITE_MODE=participant
#   관리자 프로젝트  →  SITE_MODE=admin
SITE_MODE=

# ─── 구글 로그인 ───
# 비어 있으면 로그인 화면에 체험용 로그인만 나옵니다.
#
# 받는 방법:
#   1. https://console.cloud.google.com 접속 → 프로젝트 만들기
#   2. 'API 및 서비스' → 'OAuth 동의 화면'
#      - User Type: 외부
#      - 앱 이름·지원 이메일만 채우고 저장
#   3. '사용자 인증 정보' → '사용자 인증 정보 만들기' → 'OAuth 클라이언트 ID'
#      - 애플리케이션 유형: 웹 애플리케이션
#      - '승인된 리디렉션 URI' 에 아래를 모두 등록
#          http://localhost:3000/api/auth/callback/google
#          https://배포주소/api/auth/callback/google
#   4. 발급된 클라이언트 ID / 보안 비밀번호를 아래에 붙여넣기
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── 체험용 로그인 ───
# 구글 키가 없으면 자동으로 켜집니다. 이 값은 필요 없습니다.
# 구글 키가 있는데도 체험용을 함께 쓰고 싶을 때만 true 로 둡니다. (시연용)
#
# ⚠️ 실서비스 전에는 반드시 지우세요.
#    남겨두면 아무나 다른 참여자 계정으로 들어갈 수 있습니다.
ALLOW_DEMO_LOGIN=true
